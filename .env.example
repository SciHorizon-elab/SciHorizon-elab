# LLM API 配置(复制为 .env 并填入真实值;此文件为模板,不含密钥)
# 支持任何 OpenAI 兼容 API,模型与端点完全由使用者自行配置

# API Key(必填)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容端点(可选;留空则使用 openai SDK 默认端点)
# 示例(千问 dashscope): https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=

# 文本模型名称(必填,按所选端点填写,如 qwen-plus、gpt-4o 等)
LLM_MODEL_NAME=

# 视觉模型名称(可选;reviewer 视频审核需要,如 qwen-vl-max)
LLM_VISION_MODEL_NAME=
